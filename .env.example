# Copy to .env for local development. Placeholders only: never put a real value in this file.
# Every variable here is checked by loadEnv() in src/shared/env.ts.

# The Google OAuth client of the "Desktop app" type, from the test Google Cloud project (spec 106).
# Read at build time, so `npm run build` and `npm run package` put it into the app. Leave both
# empty and Google shows as "not set up" in Settings.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# Development only: 1 runs an unpackaged build against the in-memory Google
# (src/google/fake-google.ts) instead of the real one. The packaged app ignores it.
GOOGLE_FAKE=
